# Скопируйте в .env и заполните. Файл .env в git не коммитим.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=assistant
POSTGRES_PASSWORD=assistant
POSTGRES_DB=assistant
# Для запуска сервисов локально, без docker (внутри compose переопределяется):
DATABASE_URL=postgresql://assistant:assistant@localhost:5432/assistant
REDIS_URL=redis://localhost:6379/0

# Часовой пояс для времени без смещения («завтра в 10»)
DEFAULT_TZ=Europe/Moscow

# --- GigaChat (developers.sber.ru → ключ авторизации) ---
# Пусто — поиск по смыслу выключен, остальное работает.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_VERIFY_SSL=false

# --- Агент: LLM через gpt2giga (тот же GIGACHAT_CREDENTIALS) ---
# Любая длинная случайная строка: ею агент авторизуется в gpt2giga.
LLM_API_KEY=change-me-to-random-32-chars
LLM_MODEL=GigaChat-2-Max
# Локально без docker: gpt2giga на localhost
LLM_BASE_URL=http://localhost:8090/v1
MCP_URL=http://localhost:8001/mcp

# --- MCP-сервер ---
MCP_PORT=8001
MCP_PATH=/mcp

# --- HTTP API: адрес Mini App в проде вместо * ---
API_CORS_ORIGINS=["*"]
# В MAX запросы подписаны: API получает X-Max-Init-Data и проверяет его через MAX_TOKEN.
# Только для локальной разработки с ?user_id=... включите true. В проде оставьте false.
API_ALLOW_DEV_USER_ID=false
MAX_INIT_DATA_TTL_SECONDS=3600

# --- Бот (B): MAX Bot API ---
# Токен из кабинета бота в MAX (Чат-боты → ⋮ → Настройки). Без него бот не стартует.
MAX_TOKEN=
# Секрет для подписи вебхука — любая случайная строка 5-256 символов (буквы/цифры/_/-),
# свой, не токен бота. MAX присылает его обратно в заголовке X-Max-Bot-Api-Secret.
MAX_WEBHOOK_SECRET=change-me-to-random-string
MAX_API_BASE=https://platform-api2.max.ru
# whisper — локальное распознавание (по умолчанию, не нужен внешний ключ);
# http — свой ASR-эндпоинт (ASR_HTTP_URL/ASR_HTTP_TOKEN); disabled — только текст.
ASR_PROVIDER=whisper
WHISPER_MODEL=base
ASR_HTTP_URL=
ASR_HTTP_TOKEN=
# Планировщик напоминаний: как часто смотреть в базу и насколько далеко в прошлое.
# lookback не даёт после долгого простоя вывалить пользователю все пропущенные напоминания
# (в импортированном календаре бывают и прошлогодние даты).
REMINDER_INTERVAL_SECONDS=30
REMINDER_LOOKBACK_MINUTES=60

# --- Тесты (отдельная база, её содержимое удаляется) ---
# TEST_DATABASE_URL=postgresql://assistant:assistant@localhost:5432/assistant_test
# TEST_REDIS_URL=redis://localhost:6379/15
