+async def test_completed_events_are_hidden_from_the_period_list(client):
+    """Отмеченное выполненным не должно возвращаться в «что у меня сегодня».
+
+    Регрессия живого теста: напоминание отмечали выполненным в мини-приложении,
+    а бот продолжал перечислять его как запланированное.
+    """
+    start = (
+        datetime.now().replace(microsecond=0, second=0, minute=0) + timedelta(hours=2)
+    ).astimezone()
+    created = await client.call_tool(
+        "create_event",
+        {
+            "user_id": USER,
+            "event_type": "reminder",
+            "name": "Позвонить маме",
+            "start_at": iso(start),
+            "user_text": f"напомни в {start.hour}:00 позвонить маме",
+        },
+    )
+    event_id = created.structured_content["id"]
+    period = {
+        "user_id": USER,
+        "start_time": iso(start.replace(hour=0)),
+        "end_time": iso(start.replace(hour=0) + timedelta(days=1)),
+    }
+
+    before = await client.call_tool("get_events", period)
+    assert [e["name"] for e in before.structured_content["result"]] == ["Позвонить маме"]
+
+    await client.call_tool("complete_event", {"user_id": USER, "event_id": event_id})
+
+    after = await client.call_tool("get_events", period)
+    assert after.structured_content["result"] == []
+
+    # «Что я сегодня сделал» по-прежнему должно находить запись.
+    with_done = await client.call_tool("get_events", {**period, "include_done": True})
+    assert [e["name"] for e in with_done.structured_content["result"]] == ["Позвонить маме"]
+
+
