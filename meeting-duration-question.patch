+            "вызови тул снова с confirmed=true; «нет» — ничего не делай."
+        )
+    deleted = await repo.cancel_all(user_id, types)
+    logger.info("bulk deleted %d events user=%s types=%s", len(deleted), user_id, event_types)
+    return deleted
