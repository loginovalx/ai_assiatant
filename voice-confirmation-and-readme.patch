+# Сначала вычёркиваем из фразы указания на ДЕНЬ. Иначе их цифры и слова сойдут за час:
+# «15 января» и «в пятницу» — это дата, часа в них нет.
+_DATE_WORDS = re.compile(
+    r"""
+    сегодня | завтра | послезавтра | вчера                                   |
+    понедельник\w* | вторник\w* | сред[ауыоеи]\w* | четверг\w* |
+    пятниц\w* | суббот\w* | воскресень\w*                                    |
+    (следующ\w*|этой|прошл\w*)\s+недел\w*                                     |
+    \d{4}-\d{2}-\d{2}                                                        | # 2026-10-31
+    \d{1,2}[./]\d{1,2}([./]\d{2,4})?                                         | # 31.10.2026
+    \d{1,2}\s*-?\s*(го|е|ое|ого)\b                                           | # «10-го»
+    \d{1,2}\s*числ\w*                                                        |
+    \d{0,2}\s*(январ|феврал|март|апрел|ма[йяе]|июн|июл|август|
+               сентябр|октябр|ноябр|декабр)\w*                               |
+    через\s+\d*\s*(дн|недел|месяц|год|лет)\w*
+    """,
+    re.IGNORECASE | re.VERBOSE,
+)
+
+# Что осталось после вычёркивания даты и говорит о времени суток. Числительные словами
+# («в три») намеренно не включены: «семье», «пятницу», «двадцатое» дали бы ложные
+# срабатывания, а «в три часа» и так ловится по слову «час».
+_TIME_HINTS = re.compile(
+    r"""
+    \d                                   | # «в 10», «15:30», «через 20 минут»
+    час | минут | полчаса                 |
+    полдень | полноч                      |
+    утр | днём | днем | вечер | ноч       | # части дня: их модель вправе развернуть сама
+    обед | завтрак | ужин                 | # бытовые ориентиры времени
+    через | сейчас | сразу | немедленно   |
+    половин | четверт
+    """,
+    re.IGNORECASE | re.VERBOSE,
+)
+
+
+def mentions_time(*texts: str) -> bool:
+    """Назвал ли пользователь время суток (а не только день).
+
+    «Напомни позвонить Марине», «завтра», «в пятницу», «15 января» — нет: час взять
+    неоткуда, надо спросить. «Завтра в 10», «вечером», «через час», «в три часа» — да.
+    """
+    return any(_TIME_HINTS.search(_DATE_WORDS.sub(" ", text or "")) for text in texts)
